@model Company.Data.Models.CMS.Page
@{
    ViewData["Title"] = "Home Page";
}

<div id="index-banner" class="parallax-container">
    <div class="section no-pad-bot">
        <div class="container">
            <br><br>
            @if (Model != null)
            {
                ViewData["Title"] = Model.Title;
                <h1 class="header center teal-text text-lighten-2">@Model.Title</h1>
                <div class="row center">
                    <h5 class="header col s12 light">@Html.Raw(Model.Content)</h5>
                </div>
                <div class="row center">
                    <a href="http://wp.pl" id="download-button"
                       class="btn-large waves-effect waves-light teal lighten-1">@Model.LinkTitle</a>
                </div>
                <br>
                <br>
            }
            else
            {
                <h1 class="header center teal-text text-lighten-2">Witaj w sklepie</h1>
                <div class="row center">
                    <h5 class="header col s12 light">Sklep jest nowoczesny i doskonały. Sklep jest nowoczesny i
                        doskonały. Sklep jest nowoczesny i doskonały.</h5>
                </div>
                <div class="row center">
                    <a href="http://wp.pl" id="download-button"
                       class="btn-large waves-effect waves-light teal lighten-1">Do sklepu</a>
                </div>
                <br>
                <br>
            }
        </div>
    </div>
    <div class="parallax"><img src="~/images/placeholder-1.jpg" alt="I <3 Mikruta" width="2400" height="900"></div>
</div>