<!DOCTYPE html>
<html lang="en">
@await Html.PartialAsync("Header")
<body>
<nav class="white" role="navigation">
    <div class="nav-wrapper container">
        <a id="logo-container" class="brand-logo" asp-area="" asp-controller="Home"
           asp-action="Index">Akademia WSB-NLU MVC</a>
        <ul class="right hide-on-med-and-down">
            <li>@Html.ActionLink("Strona główna", "Index", "Home")</li>
            <li>@Html.ActionLink("Oferta", "Index", "Shop")</li>
            <li>@Html.ActionLink("Koszyk", "Index", "Cart")</li>
            <li>@Html.ActionLink("Zamów", "Data", "Cart")</li>
        </ul>

        <ul id="nav-mobile" class="sidenav">
            <li>@Html.ActionLink("Strona główna", "Index", "Home")</li>
            <li>@Html.ActionLink("Oferta", "Index", "Shop")</li>
            <li>@Html.ActionLink("Koszyk", "Index", "Cart")</li>
            <li>@Html.ActionLink("Zamów", "Data", "Cart")</li>
        </ul>
        <a href="#" data-target="nav-mobile" class="sidenav-trigger"><i class="material-icons">menu</i></a>
    </div>
</nav>

<main role="main">
    @RenderBody()
</main>
@await Html.PartialAsync("Footer")
@await Html.PartialAsync("ScriptSection")
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
